<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeListActivity">

    <LinearLayout
        android:id="@+id/layoutFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/fondo_tarjeta"
            android:text="Mercadona"
            android:textColor="@color/blanco"/>
        
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/fondo_tarjeta"
            android:text="Carrefour"
            android:textColor="@color/blanco"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LayoutSliders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutFiltros">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proteïna (g)"
            android:textColor="@color/blanco"
            android:textStyle="bold"/>
        
        <SeekBar
            android:id="@+id/sbProteina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:max="100"
            android:progress="40"
            android:progressTint="@color/verde_macrosuper"
            android:thumbTint="@color/verde_macrosuper"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Calories (kcal)"
            android:textColor="@color/blanco"
            android:textStyle="bold"/>

        <SeekBar
            android:id="@+id/sbCalorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:max="1500"
            android:progress="600"
            android:progressTint="@color/naranja_alerta"
            android:thumbTint="@color/naranja_alerta"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvListaProductos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSliders"
        tools:listitem="@layout/item_producto" />


</androidx.constraintlayout.widget.ConstraintLayout>