<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fons_principal"
    android:padding="24dp"
    tools:context=".EditItemActivity">

    <TextView
        android:id="@+id/tvEditTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Editar Producte"
        android:textColor="@color/blanco"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/etEditName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom del producte (ex: Pit de pollastre)"
        android:textColorHint="@color/gris_texto"
        android:textColor="@color/blanco"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/tvEditTitle"
        android:layout_marginTop="40dp"/>

    <EditText
        android:id="@+id/etEditPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Preu (€)"
        android:inputType="numberDecimal"
        android:textColorHint="@color/gris_texto"
        android:textColor="@color/blanco"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/etEditName"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/etEditProtein"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Proteïna (g)"
        android:inputType="numberDecimal"
        android:textColorHint="@color/gris_texto"
        android:textColor="@color/blanco"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/etEditPrice"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/etEditCalories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Calories (kcal)"
        android:inputType="number"
        android:textColorHint="@color/gris_texto"
        android:textColor="@color/blanco"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/etEditProtein"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/btnSaveItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Canvis"
        android:textColor="@color/fons_principal"
        android:backgroundTint="@color/verde_macrosuper"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/etEditCalories"
        android:layout_marginTop="40dp"/>

    <Button
        android:id="@+id/btnCancelEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancel·lar"
        android:textColor="@color/naranja_alerta"
        android:backgroundTint="@color/fons_principal"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/btnSaveItem"
        android:layout_marginTop="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>