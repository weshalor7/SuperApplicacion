<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SupperApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/verd_principal</item>
        <item name="colorSecondary">@color/alertes_o_calories</item>
        <item name="android:windowBackground">@color/fons_principal</item>
    </style>

    <style name="Theme.SupperApplication" parent="Base.Theme.SupperApplication" />

    <!-- Tema Oficial para el Splash -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fondo_oscuro</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_mancuerna_vector</item>
        <item name="postSplashScreenTheme">@style/Theme.SupperApplication</item>
    </style>
</resources>